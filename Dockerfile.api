FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    HOMELAB_DATA_DIR=/var/lib/homelab-monitor \
    HOMELAB_LOG_DIR=/var/log/homelab-monitor \
    HOMELAB_DATABASE_URL=sqlite:////var/lib/homelab-monitor/homelab-monitor.db

RUN apt-get update \
    && apt-get install -y --no-install-recommends tini \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 homelab \
    && useradd --uid 10001 --gid homelab --create-home --home-dir /home/homelab \
       --shell /usr/sbin/nologin homelab \
    && mkdir -p /var/lib/homelab-monitor /var/log/homelab-monitor /app \
    && chown -R homelab:homelab /var/lib/homelab-monitor /var/log/homelab-monitor /app

WORKDIR /app

COPY --chown=homelab:homelab pyproject.toml README.md LICENSE alembic.ini ./
COPY --chown=homelab:homelab api ./api
COPY --chown=homelab:homelab agent ./agent
COPY --chown=homelab:homelab plugins ./plugins
COPY --chown=homelab:homelab shared ./shared
COPY --chown=homelab:homelab deploy/docker/api-entrypoint.sh /usr/local/bin/api-entrypoint.sh

RUN pip install --no-cache-dir . \
    && chmod 755 /usr/local/bin/api-entrypoint.sh

USER homelab
EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=40s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=4)"

ENTRYPOINT ["tini", "--", "/usr/local/bin/api-entrypoint.sh"]
