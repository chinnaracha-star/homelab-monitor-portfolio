HOMELAB_SERVER_URL=http://127.0.0.1:8000
HOMELAB_AGENT_NAME=monitor
HOMELAB_AGENT_TOKEN=replace-with-the-one-time-agent-token
HOMELAB_REPORT_INTERVAL=60
HOMELAB_CONFIG_REVISION=0
HOMELAB_REQUEST_TIMEOUT=10
HOMELAB_RETRY_ATTEMPTS=3
HOMELAB_RETRY_INITIAL_BACKOFF=1
HOMELAB_RETRY_MAX_BACKOFF=30
HOMELAB_BUFFER_PATH=/var/lib/homelab-monitor/agent-buffer.db
HOMELAB_BUFFER_MAX_REPORTS=1000
HOMELAB_CPU_WARNING_PERCENT=90
HOMELAB_MEMORY_WARNING_PERCENT=90
HOMELAB_DISK_WARNING_PERCENT=90
HOMELAB_LOG_LEVEL=INFO
