# Copy to .env and replace every placeholder before starting Docker or systemd.
# Never commit a filled-in copy. Docker Compose reads this file from the repo root.

# Runtime profile. Use production on deployed hosts.
HOMELAB_ENVIRONMENT=production

# SQLite URL. Docker Compose overrides this to the data volume path.
# Host systemd should use sqlite:////var/lib/homelab-monitor/homelab-monitor.db
HOMELAB_DATABASE_URL=sqlite:////var/lib/homelab-monitor/homelab-monitor.db

# Directory for JSONL API logs. Empty keeps logs on stdout only.
HOMELAB_LOG_DIR=/var/log/homelab-monitor

# Logging verbosity: DEBUG, INFO, WARNING, ERROR.
HOMELAB_LOG_LEVEL=INFO

# Bootstrap key for POST /api/v1/agents/register. Minimum 24 characters.
HOMELAB_REGISTRATION_KEY=replace-with-a-long-random-registration-key

# HS256 secret for dashboard JWTs. Minimum 32 characters.
HOMELAB_JWT_SECRET=replace-with-a-long-random-jwt-secret-key

# Dashboard access-token lifetime in minutes (1 to 10080).
HOMELAB_JWT_EXPIRE_MINUTES=60

# First-boot dashboard users. Production requires the admin password.
# Leave operator/viewer empty to skip those accounts.
HOMELAB_BOOTSTRAP_ADMIN_PASSWORD=change-me-bootstrap-admin-password
HOMELAB_BOOTSTRAP_OPERATOR_PASSWORD=
HOMELAB_BOOTSTRAP_VIEWER_PASSWORD=

# Default agent reporting interval until the server overrides it (15 to 3600).
HOMELAB_AGENT_REPORT_INTERVAL_SECONDS=60

# Agent version policy returned in control responses.
HOMELAB_MINIMUM_AGENT_VERSION=0.1.0
HOMELAB_LATEST_AGENT_VERSION=0.1.0

# Alert engine thresholds.
HOMELAB_ALERT_CPU_THRESHOLD_PERCENT=90
HOMELAB_ALERT_MEMORY_THRESHOLD_PERCENT=90
HOMELAB_ALERT_DISK_THRESHOLD_PERCENT=90
HOMELAB_ALERT_TEMPERATURE_THRESHOLD_CELSIUS=85

# Mark an agent offline when last contact is older than this many seconds.
HOMELAB_AGENT_OFFLINE_AFTER_SECONDS=180

# How often the API evaluates offline agents (5 to 3600 seconds).
HOMELAB_ALERT_EVALUATION_INTERVAL_SECONDS=30

# Comma-separated proxy IPs allowed to set forwarded headers. Docker default is *.
HOMELAB_FORWARDED_ALLOW_IPS=*

# Optional Telegram Bot API integration. Leave token and chat empty to disable.
TELEGRAM_API_BASE_URL=https://api.telegram.org
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_REQUEST_TIMEOUT=10
HOMELAB_TELEGRAM_ENABLED=false
HOMELAB_NOTIFICATION_WORKER_ENABLED=true

# Dashboard image build argument. Keep relative so nginx can reverse-proxy /api.
VITE_API_BASE_URL=/api/v1

# Infrastructure / photo connectors default to mock snapshots.
HOMELAB_INFRASTRUCTURE_MOCK=true
HOMELAB_INFRASTRUCTURE_REFRESH_SECONDS=30
HOMELAB_INFRASTRUCTURE_TIMEOUT_SECONDS=2
HOMELAB_QNAP_URL=
HOMELAB_QNAP_USERNAME=
HOMELAB_QNAP_PASSWORD=
HOMELAB_QNAP_SID=
HOMELAB_DOCKER_URL=
HOMELAB_IMMICH_URL=
HOMELAB_IMMICH_API_KEY=
HOMELAB_QUMAGIE_URL=
HOMELAB_QUMAGIE_API_KEY=
HOMELAB_BACKUP_URL=

HOMELAB_PHOTO_WATCH_FOLDER=/data/photos
HOMELAB_PHOTO_WATCHER_ENABLED=true
HOMELAB_PHOTO_SCAN_INTERVAL_SECONDS=5

# Optional. Used by docker-compose.tailscale.yml for loopback dashboard + Serve.
# HOMELAB_DASHBOARD_PORT=18081
# HOMELAB_TAILSCALE_SOCKET=/var/run/tailscale/tailscaled.sock
# Optional override for the API-to-nginx production health probe (internal only).
# HOMELAB_DASHBOARD_HEALTH_URL=http://dashboard:8080/
# HOMELAB_API_HEALTH_URL=http://api:8000/health
# Telegram / mobile buttons (never Docker hostnames).
# HOMELAB_DASHBOARD_PUBLIC_URL=https://monitor.example.com
# HOMELAB_IMMICH_PUBLIC_URL=
# HOMELAB_QNAP_PUBLIC_URL=
