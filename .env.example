# Copy to .env and replace placeholders. Never commit a filled-in copy.

# Runtime profile: development | production
HOMELAB_ENVIRONMENT=development
HOMELAB_DATABASE_URL=sqlite:///./data/homelab-monitor.db
HOMELAB_LOG_LEVEL=INFO
HOMELAB_LOG_DIR=

# Required secrets (registration key min 24 chars, JWT secret min 32 chars).
HOMELAB_REGISTRATION_KEY=replace-with-a-long-random-registration-key
HOMELAB_JWT_SECRET=replace-with-a-long-random-jwt-secret-key
HOMELAB_JWT_EXPIRE_MINUTES=60

# First-boot dashboard users. Production requires HOMELAB_BOOTSTRAP_ADMIN_PASSWORD.
# Operator and viewer accounts are created only when their passwords are set.
# Do not use admin123 / operator123 / viewer123.
HOMELAB_BOOTSTRAP_ADMIN_PASSWORD=change-me-bootstrap-admin-password
HOMELAB_BOOTSTRAP_OPERATOR_PASSWORD=
HOMELAB_BOOTSTRAP_VIEWER_PASSWORD=

HOMELAB_AGENT_REPORT_INTERVAL_SECONDS=60
# Agent protocol floor. Independent of the API package version (1.0.0-rc1).
HOMELAB_MINIMUM_AGENT_VERSION=0.1.0
HOMELAB_LATEST_AGENT_VERSION=0.1.0

# Used as fallback thresholds when no alert_rules rows exist.
HOMELAB_ALERT_CPU_THRESHOLD_PERCENT=90
HOMELAB_ALERT_MEMORY_THRESHOLD_PERCENT=90
HOMELAB_ALERT_DISK_THRESHOLD_PERCENT=90
HOMELAB_ALERT_TEMPERATURE_THRESHOLD_CELSIUS=85
HOMELAB_AGENT_OFFLINE_AFTER_SECONDS=180
HOMELAB_ALERT_EVALUATION_INTERVAL_SECONDS=30

# Uvicorn proxy trust. Docker default is *.
HOMELAB_FORWARDED_ALLOW_IPS=*

# Optional Telegram Bot API integration.
TELEGRAM_API_BASE_URL=https://api.telegram.org
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_REQUEST_TIMEOUT=30
HOMELAB_TELEGRAM_ENABLED=false
HOMELAB_NOTIFICATION_WORKER_ENABLED=true

# Optional Discord / Slack / email can also be configured in the dashboard
# Settings page (stored in notification_settings).

# Host port for docker compose dashboard publish.
# HOMELAB_DASHBOARD_PORT=8080

# Infrastructure connectors default to mock snapshots (no NAS required).
HOMELAB_INFRASTRUCTURE_MOCK=true
HOMELAB_INFRASTRUCTURE_REFRESH_SECONDS=30
HOMELAB_INFRASTRUCTURE_TIMEOUT_SECONDS=2
HOMELAB_QNAP_URL=
HOMELAB_QNAP_USERNAME=
HOMELAB_QNAP_PASSWORD=
HOMELAB_QNAP_SID=
# Keep true unless this NAS uses a trusted local self-signed certificate.
HOMELAB_QNAP_TLS_VERIFY=true
HOMELAB_QNAP_TIMEOUT_SECONDS=10
HOMELAB_DOCKER_URL=
HOMELAB_IMMICH_URL=
HOMELAB_IMMICH_API_KEY=
HOMELAB_QUMAGIE_URL=
HOMELAB_QUMAGIE_API_KEY=
HOMELAB_BACKUP_URL=

# SQLite gzip backups (Asia/Bangkok). Destination is on the homelab-data volume.
HOMELAB_BACKUP_ENABLED=true
HOMELAB_BACKUP_PATH=/var/lib/homelab-monitor/backups
HOMELAB_BACKUP_RETENTION_DAILY=7
HOMELAB_BACKUP_RETENTION_WEEKLY=4
HOMELAB_BACKUP_RETENTION_MONTHLY=6
HOMELAB_BACKUP_TIME=02:00
HOMELAB_BACKUP_TIMEZONE=Asia/Bangkok

# Photo Monitor default folders (JSON list). Legacy single path still works.
# HOMELAB_PHOTO_WATCH_FOLDERS=["/data/photos","/data/photos/library-a","/data/photos/library-b","/data/photos/library-c","/data/photos/library-d","/data/photos/library-e"]
HOMELAB_PHOTO_WATCH_FOLDER=/data/photos
HOMELAB_PHOTO_WATCHER_ENABLED=true
HOMELAB_PHOTO_SCAN_INTERVAL_SECONDS=5

# Optional Tailscale status (read-only). The API never configures Tailscale.
# HOMELAB_TAILSCALE_BIN=tailscale
# HOMELAB_TAILSCALE_SOCKET=/var/run/tailscale/tailscaled.sock
# HOMELAB_TAILSCALE_TIMEOUT_SECONDS=2
# HOMELAB_DASHBOARD_HEALTH_URL=http://127.0.0.1:8080/
# HOMELAB_API_HEALTH_URL=http://127.0.0.1:8000/health
# HOMELAB_DASHBOARD_PUBLIC_URL=https://monitor.example.com
# HOMELAB_IMMICH_PUBLIC_URL=
# HOMELAB_QNAP_PUBLIC_URL=
